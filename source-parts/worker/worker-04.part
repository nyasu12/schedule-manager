import { validatedDate, validatedTime } from './runtime-guards.js';

function sanitizeSchedule(body) {
  const date = validatedDate(body.date, '開始日', true);
  const areaId = trim(body.areaId ?? body.regionId, 80);
  const scheduleTypeId = trim(body.scheduleTypeId ?? body.purposeId, 80);
  if (!areaId) throw new Error('エリアを選択してください。');
  if (!scheduleTypeId) throw new Error('予定タイプを選択してください。');
  const returnDate = validatedDate(body.returnDate, '終了日');
  if (returnDate && returnDate < date) throw new Error('終了日は開始日以降にしてください。');

  const rawLocations = Array.isArray(body.locations) ? body.locations : (Array.isArray(body.stores) ? body.stores : []);
  const locations = rawLocations.slice(0, 50).map((row) => ({
    organizationId: trim(row?.organizationId ?? row?.companyId, 80),
    locationId: trim(row?.locationId ?? row?.storeId, 80),
    note: trim(row?.note, 300),
  })).filter((row) => row.organizationId || row.locationId || row.note);

  const rawAssignees = Array.isArray(body.assignees) ? body.assignees : body.employees;
  const assignees = Array.isArray(rawAssignees) ? [...new Set(rawAssignees.map((x) => trim(x, 80)).filter(Boolean))].slice(0, 100) : [];
  const rawResources = Array.isArray(body.resources) ? body.resources : body.cars;
  const resources = Array.isArray(rawResources) ? [...new Set(rawResources.map((x) => trim(x, 80)).filter(Boolean))].slice(0, 100) : [];
  const workflowStatus = ['draft','planned','confirmed','in_progress','done','cancelled'].includes(trim(body.workflowStatus, 30)) ? trim(body.workflowStatus, 30) : 'planned';
  const startTime = validatedTime(body.startTime ?? body.departureTime, '開始時刻');

  return {
    id: trim(body.id, 100) || makeId('SCH'),
    date,
    returnDate,
    areaId,
    scheduleTypeId,
    startTime,
    workflowStatus,
    otherContent: trim(body.otherContent, 1000),
    otherTransport: trim(body.otherTransport, 500),
    memo: trim(body.memo, 5000),
    locations,
    assignees,
    resources,
  };
}

async function saveSchedule(request, env) {
  let body;
  try {
    body = await readJson(request);
  } catch (e) {
    return fail(e?.message || String(e));
  }
  const requestedId = trim(body?.id, 100);
  const existing = requestedId ? await env.DB.prepare('SELECT id,deleted_at,start_time,memo FROM core_schedules_v1 WHERE id=?').bind(requestedId).first() : null;
  const auth = await requireCapability(request, env, existing ? 'schedule.edit' : 'schedule.create');
  if (auth.response) return auth.response;

  let schedule;
  let extensionPayloads;
  let customFieldValues;
  try {
    schedule = sanitizeSchedule(body);
    if (existing) {
      if (!capabilityAllowed(auth.session.capabilities, 'schedule.start_time.edit', auth.session.role)) schedule.startTime = existing.start_time || '';
      if (!capabilityAllowed(auth.session.capabilities, 'schedule.memo.edit', auth.session.role)) schedule.memo = existing.memo || '';
    }
    const scheduleType = await env.DB.prepare('SELECT id FROM core_schedule_types_v1 WHERE id=?').bind(schedule.scheduleTypeId).first();
    if (!scheduleType) return fail('予定タイプが見つかりません。');
    extensionPayloads = await sanitizeScheduleExtensions(env, schedule.scheduleTypeId, body);
    customFieldValues = await sanitizeCustomFieldValues(env, schedule.scheduleTypeId, body.customFields);
  } catch (e) {
    return fail(e?.message || String(e));
  }

  const statements = [];
  appendCoreSchedulePersistenceStatements(env, statements, schedule);
  appendExtensionPersistenceStatements(env, statements, schedule.id, extensionPayloads);
  appendCustomFieldPersistenceStatements(env, statements, schedule.id, customFieldValues);
  await env.DB.batch(statements);
  await writeAuditLog(env, request, {
    actorUsername: auth.session.username,
    category: 'schedule',
    action: existing ? 'schedule_update' : 'schedule_create',
    targetType: 'schedule',
    targetId: schedule.id,
    summary: `${schedule.date} の予定を${existing ? '更新' : '作成'}しました`,
    details: { date: schedule.date, scheduleTypeId: schedule.scheduleTypeId, workflowStatus: schedule.workflowStatus },
  });
  return json({ ok: true, id: schedule.id });
}