const OPENAI_TRAVEL_SCHEMA = {
  type: 'object',
  additionalProperties: false,
  required: ['reservationNumber','flights'],
  properties: {
    reservationNumber: { type: 'string' },
    flights: {
      type: 'array',
      maxItems: 12,
      items: {
        type: 'object',
        additionalProperties: false,
        required: ['direction','airlineCode','flightNumber','flightDate','origin','destination','scheduledDeparture','scheduledArrival','reservationNumber','terminal','gate','confidence','notes'],
        properties: {
          direction: { type: 'string', enum: ['入国','帰国','その他'] },
          airlineCode: { type: 'string' },
          flightNumber: { type: 'string' },
          flightDate: { type: 'string' },
          origin: { type: 'string' },
          destination: { type: 'string' },
          scheduledDeparture: { type: 'string' },
          scheduledArrival: { type: 'string' },
          reservationNumber: { type: 'string' },
          terminal: { type: 'string' },
          gate: { type: 'string' },
          confidence: { type: 'number', minimum: 0, maximum: 1 },
          notes: { type: 'string' },
        },
      },
    },
  },
};
function normalizeAiFlight(x, index) {
  return forceJapanPhilippinesDirection({
    direction: ['入国','帰国','その他'].includes(trim(x?.direction, 20)) ? trim(x?.direction, 20) : '',
    sortOrder: index + 1,
    airlineCode: trim(x?.airlineCode, 10).replace(/\s/g, '').toUpperCase(),
    flightNumber: trim(x?.flightNumber, 30).replace(/\s/g, '').toUpperCase(),
    flightDate: normalizeDate(x?.flightDate),
    origin: trim(x?.origin, 80).toUpperCase(),
    destination: trim(x?.destination, 80).toUpperCase(),
    scheduledDeparture: normalizeTime(x?.scheduledDeparture),
    scheduledArrival: normalizeTime(x?.scheduledArrival),
    reservationNumber: trim(x?.reservationNumber, 120).toUpperCase(),
    terminal: trim(x?.terminal, 80),
    gate: trim(x?.gate, 80),
    confidence: Number.isFinite(Number(x?.confidence)) ? Math.max(0, Math.min(1, Number(x.confidence))) : 0,
    notes: trim(x?.notes, 300),
  });
}
function meaningfulFlight(f) {
  return !!(f?.flightNumber || f?.airlineCode || f?.flightDate || f?.origin || f?.destination);
}
async function parseTravelDocumentWithOpenAI(env, text, targetDirection = '') {
  if (!env.OPENAI_API_KEY) throw new Error('OPENAI_API_KEY が未設定です。');
  const used = await getUsage(env, 'openai');
  const limit = safeInt(env.OPENAI_MONTHLY_LIMIT, 300);
  if (used >= limit) throw new Error(`OpenAI解析のアプリ内上限（${limit}回/月）に達しました。`);
  const model = trim(env.OPENAI_MODEL || 'gpt-4.1-mini', 80) || 'gpt-4.1-mini';
  const directionHint = targetDirection === '入国' ? '入国（フィリピン等の海外→日本）' : targetDirection === '帰国' ? '帰国（日本→フィリピン等の海外）' : '入国・帰国の両方';
  const response = await fetch('https://api.openai.com/v1/chat/completions', {
    method: 'POST',
    headers: { 'authorization': `Bearer ${env.OPENAI_API_KEY}`, 'content-type': 'application/json' },
    body: JSON.stringify({
      model,
      messages: [
        { role: 'system', content: 'あなたは航空旅程表OCRの構造化担当です。OCR文字列に書かれている事実だけを使い、推測で便名・日付・空港・時刻を作らないでください。日本着は入国、日本発は帰国として分類してください。フィリピンと日本の経路を優先的に正しく分類してください。時刻は旅程表記載の現地時刻をHH:MMで返してください。' },
        { role: 'user', content: `対象方向: ${directionHint}\n\nOCR文字列:\n${String(text || '').slice(0, 24000)}` },
      ],
      response_format: {
        type: 'json_schema',
        json_schema: { name: 'flight_itinerary_extraction', strict: true, schema: OPENAI_TRAVEL_SCHEMA },
      },
      max_completion_tokens: 2200,
    }),
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) {
    const detail = data?.error?.message || `OpenAI API HTTP ${response.status}`;
    throw new Error(`OpenAI旅程表解析に失敗しました: ${detail}`);
  }
  await addUsage(env, 'openai', 1);
  const choice = data?.choices?.[0]?.message;
  if (choice?.refusal) throw new Error(`OpenAIが解析を拒否しました: ${trim(choice.refusal, 200)}`);
  const content = choice?.content;
  if (!content) throw new Error('OpenAIから旅程表解析結果が返りませんでした。');
  let parsed;
  try { parsed = JSON.parse(content); } catch { throw new Error('OpenAIの旅程表解析結果JSONを読み取れませんでした。'); }
  const reservationNumber = trim(parsed?.reservationNumber, 120).toUpperCase();
  const flights = (Array.isArray(parsed?.flights) ? parsed.flights : [])
    .map((x, i) => normalizeAiFlight({ ...x, reservationNumber: x?.reservationNumber || reservationNumber }, i))
    .filter(meaningfulFlight);
  return { reservationNumber, flights, model, used: used + 1, limit };
}
