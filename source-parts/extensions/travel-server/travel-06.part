async function visionRecognizeFile(env, file) {
  if (!env.GOOGLE_VISION_API_KEY) throw new Error('GOOGLE_VISION_API_KEY が未設定です。');
  if (!(file instanceof File)) throw new Error('画像またはPDFを選択してください。');
  if (file.size > 7 * 1024 * 1024) throw new Error('自動読み取りは1ファイル7MBまでです。');
  const ext = extension(file.name || '');
  const inferredMime = ({ pdf:'application/pdf', jpg:'image/jpeg', jpeg:'image/jpeg', png:'image/png', webp:'image/webp', gif:'image/gif' })[ext] || '';
  if (!inferredMime) throw new Error('自動読み取りはPDF/JPG/PNG/WEBP/GIFに対応しています。');
  const used = await getUsage(env, 'vision');
  const limit = safeInt(env.VISION_MONTHLY_LIMIT, 900);
  if (used >= limit) throw new Error(`Vision APIのアプリ内上限（${limit}回/月）に達しました。`);
  const buffer = await file.arrayBuffer();
  const base64 = arrayBufferToBase64(buffer);
  let endpoint, body, units;
  if (inferredMime === 'application/pdf') {
    endpoint = `https://vision.googleapis.com/v1/files:annotate?key=${encodeURIComponent(env.GOOGLE_VISION_API_KEY)}`;
    body = { requests: [{ inputConfig: { content: base64, mimeType: 'application/pdf' }, features: [{ type: 'DOCUMENT_TEXT_DETECTION' }], pages: [1,2,3,4,5] }] };
    units = 5;
  } else {
    endpoint = `https://vision.googleapis.com/v1/images:annotate?key=${encodeURIComponent(env.GOOGLE_VISION_API_KEY)}`;
    body = { requests: [{ image: { content: base64 }, features: [{ type: 'DOCUMENT_TEXT_DETECTION' }] }] };
    units = 1;
  }
  if (used + units > limit) throw new Error(`Vision APIのアプリ内上限（${limit}回/月）を超えるため処理できません。`);
  const response = await fetch(endpoint, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
  const data = await response.json().catch(() => ({}));
  if (!response.ok || data.error) throw new Error(data.error?.message || `Vision API HTTP ${response.status}`);
  let text = '';
  if (inferredMime === 'application/pdf') {
    for (const page of data.responses?.[0]?.responses || []) text += (page.fullTextAnnotation?.text || page.textAnnotations?.[0]?.description || '') + '\n';
  } else text = data.responses?.[0]?.fullTextAnnotation?.text || data.responses?.[0]?.textAnnotations?.[0]?.description || '';
  await addUsage(env, 'vision', units);
  return { text, units, used: used + units, limit, mimeType: inferredMime };
}
async function previewTravelDocument(request, env) {
  const auth = await requireRole(request, env, ['manager','admin']);
  if (auth.response) return auth.response;
  try {
    const form = await request.formData();
    const file = form.get('file');
    const targetDirection = ['入国','帰国'].includes(trim(form.get('targetDirection'), 20)) ? trim(form.get('targetDirection'), 20) : '';
    const recognized = await visionRecognizeFile(env, file);
    const rulesParsed = parseTravelItinerary(recognized.text);
    let parsed = rulesParsed;
    let parser = 'rules';
    let aiWarning = '';
    let openai = { used: await getUsage(env, 'openai'), limit: safeInt(env.OPENAI_MONTHLY_LIMIT, 300), model: trim(env.OPENAI_MODEL || 'gpt-4.1-mini', 80) || 'gpt-4.1-mini' };
    if (env.OPENAI_API_KEY) {
      try {
        const aiParsed = await parseTravelDocumentWithOpenAI(env, recognized.text, targetDirection);
        parsed = mergeTravelParses(aiParsed, rulesParsed);
        if (targetDirection) parsed = { ...parsed, flights: (parsed.flights || []).map(forceJapanPhilippinesDirection).filter((f) => f.direction === targetDirection) };
        parser = aiParsed.flights.length ? 'openai' : 'rules';
        openai = { used: aiParsed.used, limit: aiParsed.limit, model: aiParsed.model };
        if (!aiParsed.flights.length && rulesParsed.flights.length) aiWarning = 'OpenAIでは便を確定できなかったため、従来ルールの解析結果を使用しました。';
      } catch (e) {
        aiWarning = e?.message || String(e);
        parsed = rulesParsed;
        parser = 'rules';
      }
    } else aiWarning = 'OPENAI_API_KEY が未設定のため、従来ルールだけで解析しました。';
    return json({ ok: true, filename: file.name, text: recognized.text, parsed, targetDirection, parser, aiWarning, openai, candidates: extractOcrCandidates(recognized.text), units: recognized.units, used: recognized.used, limit: recognized.limit });
  } catch (e) {
    const message = e?.message || String(e);
    const status = /未設定/.test(message) ? 503 : /上限/.test(message) ? 429 : 400;
    return fail(message, status);
  }
}
